# Production environment — copy to `.env` and set REAL values before deploying.
# The API refuses to boot in production if GOVUX_SECRET_KEY is unset or equals the
# JWT secret (see app/services/secretbox.py: assert_production_key).

# --- database ---
POSTGRES_USER=govux
POSTGRES_PASSWORD=            # REQUIRED: strong random password
POSTGRES_DB=govux

# --- secrets (REQUIRED, must be distinct, 32+ random chars each) ---
GOVUX_JWT_SECRET=             # signs access tokens — never the default
GOVUX_SECRET_KEY=            # encrypts SMTP/CAPTCHA secrets at rest — MUST differ from JWT secret

# --- frontend / CORS ---
GOVUX_CORS_ORIGINS=https://govux.gov.in      # comma-separated real browser origins

# --- optional integrations ---
GOVUX_CRUX_API_KEY=          # Chrome UX Report field data (blank = lab-only performance)

# Generate secrets, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
